# ============================================================================
# 1. WALLET & RPC CONFIGURATION (Keep private! chmod 600 .env)
# ============================================================================
PRIVATE_KEY=0xYOUR_64_HEX_PRIVATE_KEY

# Public fallbacks are for connectivity checks only. Use dedicated RPCs on VPS.
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
OPTIMISM_RPC_URL=https://mainnet.optimism.io
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
STABLE_RPC_URL=https://rpc.stable.xyz
MONAD_RPC_URL=https://rpc.monad.xyz
TEMPO_RPC_URL=https://rpc.tempo.xyz
KATANA_RPC_URL=https://rpc.katana.network

# Optional Real-Time Event-Driven WebSocket (wss://) & Base Flashblocks Stream
WSS_STREAM_ENABLED=true
MIN_WS_TRIGGER_INTERVAL_MS=1500
ETH_WSS_URL=
BASE_FLASHBLOCKS_WSS_URL=
BASE_WSS_URL=
ARB_WSS_URL=
OP_WSS_URL=

# ============================================================================
# 2. LLM OPERATOR CONFIGURATION (OpenAI-Compatible API)
# Supports OpenAI, OpenRouter, DeepSeek, Groq, Ollama, vLLM, etc.
# ============================================================================
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-YOUR_OPENAI_OR_OPENROUTER_KEY
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_MS=25000
LLM_FALLBACK_DETERMINISTIC=true

# ============================================================================
# 3. VPS WATCH & EXECUTOR POLICY
# Modes: dry-run | whitelist-only | flashloan | arbitrage | liquidation | full
# ============================================================================
OPERATOR_MODE=dry-run
AUTO_BROADCAST=false
WATCH_CHAINS=base,arbitrum,ethereum
WATCH_INTERVAL_SEC=30
WATCH_HTTP_PORT=3000
# Optional Bearer token to protect POST /api/trigger and POST /api/mode
OPERATOR_API_TOKEN=

# Liquidity & Whitelist Policy
MIN_LIQUIDITY_USD=100000
MAX_PRICE_AGE_HOURS=24
WHITELIST_AUTO_SYNC=true
# Comma-separated symbols to auto-allowlist (empty or ALL = all eligible assets)
WHITELIST_TARGETS=USDC,USDT,DAI,WETH,WBTC,cbBTC
FLASHLOAN_ON_WHITELIST=false
FLASHLOAN_TRIGGER_USD=10000

# Arbitrage, Multi-DEX, Triangular Multi-Hop, Liquidation, & MEV Policy
ARB_LOAN_USD=10000
MIN_PROFIT_USD=5
MAX_SLIPPAGE_BPS=30
MAX_GAS_GWEI=50
ARB_DEADLINE_SEC=120
TRIANGULAR_ARB_ENABLED=true
ONCHAIN_BORROW_INDEXER_ENABLED=false
# Fast-Path executes profitable opportunities in <1ms without waiting for HTTP LLM latency
FAST_PATH_ENABLED=true
# Percentage of profit surplus allocated to EIP-1559 Priority Fee / Bribe (1500 = 15%)
PROFIT_BRIBE_BPS=1500
MAX_PRIORITY_FEE_GWEI=15
# Optional: Private MEV-Protected RPC for broadcast (e.g. https://rpc.flashbots.net or https://rpc.mevblocker.io)
PRIVATE_TX_RPC_URL=
ETHEREUM_PRIVATE_RPC_URL=
BASE_PRIVATE_RPC_URL=
ARBITRUM_PRIVATE_RPC_URL=
# Optional: Native Flashbots / Titan / Beaverbuild Bundle Submission (eth_sendBundle)
MEV_BUNDLE_ENABLED=false
MEV_BUNDLE_RELAYS=https://relay.flashbots.net,https://rpc.titanbuilder.xyz,https://rpc.beaverbuild.org
FLASHBOTS_AUTH_KEY=
# Optional profit receiver address (defaults to executor owner)
PROFIT_RECEIVER=

# ============================================================================
# 4. TELEGRAM TWO-WAY BOT CONTROLLER & ALERTS
# Set TELEGRAM_BOT_TOKEN (from @BotFather) & TELEGRAM_CHAT_ID to enable
# automated notifications AND 2-way Telegram control (/menu, /status, /scan, /mode, /broadcast, /ask)
# ============================================================================
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: comma-separated list of additional Telegram User IDs allowed to control the bot
TELEGRAM_ADMIN_IDS=
