{
  "name": "morpho-allchain-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "compile:contracts": "tsx src/commands/compile-contracts.ts",
    "test": "tsx --test src/morpho/*.test.ts src/agent/*.test.ts src/commands/*.test.ts",
    "start": "tsx src/commands/status.ts",
    "cli": "tsx src/cli.ts",
    "watch": "tsx src/commands/watch.ts",
    "agent": "tsx src/commands/watch.ts",
    "dry-run": "tsx src/commands/dry-run.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "solc": "0.8.24",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "solc": {
      "tmp": "0.2.7"
    }
  }
}
